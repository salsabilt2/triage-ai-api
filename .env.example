# Copy this file to .env and fill in your key.
# Leave OPENAI_API_KEY empty to run the whole app in demo mode (no key required).
OPENAI_API_KEY=

# Model used for triage. gpt-5-nano is the cheapest option as of August 2026.
OPENAI_MODEL=gpt-5-nano

# Which prompt version to load from prompts/ (1 or 2).
PROMPT_VERSION=2

# Seconds to wait for the OpenAI API before giving up.
REQUEST_TIMEOUT=30
